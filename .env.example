# Wi-Fi credentials — local development only (NEVER commit).
#
# Copy this file to `.env` at the repo root and fill in your own
# router SSID and password. The `.env` file is gitignored.
#
#     cp env_example_template .env   # then edit .env with your values
#
# The helper `tools/gen-wifi-credentials.sh` reads .env and emits
# `firmware/gateway/main/wifi_credentials.local.h` (also gitignored)
# at build time when these keys are present.
#
# Build with empty values to compile cleanly with STA disabled
# and AP open (CI mode). The Kconfig defaults in
# `firmware/gateway/components/wifi_manager/Kconfig.projbuild`
# define the AP SSID/channel/max-conn and the empty AP password
# fallback. Real AP passwords (when you want WPA2-PSK on the AP)
# are injected via .env as `WIFI_MGR_LOCAL_AP_PASSWORD`.

# Replace with your 2.4 GHz router SSID. Up to 32 ASCII octets.
WIFI_MGR_LOCAL_STA_SSID=

# Replace with your router WPA2-PSK password. Up to 63 ASCII octets.
# Leave empty to keep STA disabled.
WIFI_MGR_LOCAL_STA_PASSWORD=

# Optional: set a non-empty AP password to make the IIoT-Gateway
# AP require WPA2-PSK. Empty means AP open (default).
WIFI_MGR_LOCAL_AP_PASSWORD=
