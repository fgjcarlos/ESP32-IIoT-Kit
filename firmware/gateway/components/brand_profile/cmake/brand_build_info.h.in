/*
 * Generated by the brand_profile component at configure time. Do not edit.
 *
 * The values come from the selected brand profile and from the working tree,
 * so the compiled firmware always reports the identity and the revision it
 * was actually built with.
 */
#pragma once

/** Identifier of the compiled brand profile. */
#define BRAND_BUILD_PROFILE_ID   "@BRAND_PROFILE_ID@"

/** Short commit SHA of the build, "-dirty" when the tree was modified. */
#define BRAND_BUILD_REVISION     "@BRAND_BUILD_REVISION@"

/** Width of the embedded logo, in pixels. */
#define BRAND_LOGO_WIDTH         @BRAND_LOGO_WIDTH@u

/** Height of the embedded logo, in pixels. */
#define BRAND_LOGO_HEIGHT        @BRAND_LOGO_HEIGHT@u

/** Size of the embedded logo, in bytes. */
#define BRAND_ASSET_BYTES        @BRAND_LOGO_BYTES@u

/** Version of the asset bundle of this profile. */
#define BRAND_ASSET_VERSION      "@BRAND_ASSET_VERSION@"

/** Flash budget granted to the brand assets, in bytes. */
#define BRAND_ASSET_BUDGET_BYTES @BRAND_ASSET_BUDGET_BYTES@u
