# Flash layout
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y

# MQTT (esp-mqtt built-in) — required for Sparkplug B transport
# MQTT_PROTOCOL_311 is set in sdkconfig already by the esp-mqtt component defaults.
# We pin it explicitly here as a defence against future menuconfig changes.
CONFIG_MQTT_PROTOCOL_311=y
# CONFIG_MQTT_PROTOCOL_5 is not set
CONFIG_MQTT_TRANSPORT_SSL=y
# CONFIG_MQTT_TRANSPORT_WEBSOCKET is not set
# CONFIG_MQTT_TRANSPORT_WEBSOCKET_SECURE is not set

# TLS (mbedTLS via esp-tls) — required for mqtts:// brokers
CONFIG_ESP_TLS_USING_MBEDTLS=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

# Logging — verbose enough for harness-driven conformance tests
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_VERBOSE=y

# Sparkplug B feature — provided by components/sparkplug_b/Kconfig
# Default off: mqtt_bridge stays a no-op until commit 4 enables it
# CONFIG_SPARKPLUG_B_ENABLED is not set

# Brand profile (issue #12) — the white-label layer.
# The reference profile of this repository. Switch to
# CONFIG_BRAND_PROFILE_ACME_INDUSTRIAL to build the example customer
# profile from the very same sources.
CONFIG_BRAND_PROFILE_IIOT_KIT=y
# CONFIG_BRAND_PROFILE_ACME_INDUSTRIAL is not set

# Reproducible builds (issue #12) — the branded artifact must be a function
# of the sources and of the profile, nothing else. Without this the image
# carries the compile timestamp and the absolute build paths, so two builds
# of the same commit differ.
CONFIG_APP_COMPILE_TIME_DATE=n
CONFIG_APP_REPRODUCIBLE_BUILD=y

# Main task stack: app_main() calls nvs_config_init() (nvs_flash_init) and
# the NVS driver needs more than the 3584-byte default. With the default the
# gateway aborts with "A stack overflow in task main has been detected" right
# after boot.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Console: this carrier only wires the native USB port, so UART0 is not
# reachable and the gateway log would be invisible. The secondary
# USB-Serial/JTAG console publishes it on /dev/ttyACM*.
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y

# OTA rollback (issue #13) — the bootloader keeps the image that was just
# installed in the PENDING_VERIFY state until the application confirms it.
# Without this the bootloader would start the new image without any way to
# go back to the previous one.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y