/**
 * @file wifi_credentials.local.h.example
 * @brief Hand-edited template for the gitignored local credentials header.
 *
 * Recommended workflow (issue #21 secret policy):
 *
 *     1. Copy `/.env.example` to `/.env` at the repo root and edit
 *        the keys with your real SSID and password.
 *     2. Run `bash tools/gen-wifi-credentials.sh` to emit this file
 *        from .env. The header is gitignored and never committed.
 *     3. `idf.py -C firmware/gateway build` picks up the generated
 *        header automatically through the include path.
 *
 * If you do not want to use .env, you can also edit this template
 * directly:
 *
 *     cp firmware/gateway/main/wifi_credentials.local.h.example \
 *        firmware/gateway/main/wifi_credentials.local.h
 *
 * then fill in the macros. The real file is gitignored and must
 * NEVER be committed.
 *
 * Both macros are optional: leaving them undefined disables STA
 * association and turns the gateway into AP-only during bring-up.
 * Empty SSID or empty password is the Kconfig-default fallback.
 */

#pragma once

/* Replace with your router SSID. Up to 32 ASCII octets. */
// #define WIFI_MGR_LOCAL_STA_SSID        "MyRouterSSID"

/* Replace with your router password (WPA2-PSK). Up to 63 ASCII octets. */
// #define WIFI_MGR_LOCAL_STA_PASSWORD    "change-me-locally"

/* Optional: AP password for the IIoT-Gateway soft-AP. Empty = open AP. */
// #define WIFI_MGR_LOCAL_AP_PASSWORD     "open-or-shared-secret"

